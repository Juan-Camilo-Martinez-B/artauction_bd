# Postgres (Neon en producción). La usan Prisma y los scripts de respaldo.
DATABASE_URL=postgresql://artauction:artauction@localhost:5432/artauction?schema=public

# MongoDB (Atlas M0 en producción). La usan los scripts de índices y semilla.
MONGODB_URI=mongodb://localhost:27017/artauction

# Directorio local de volcados. No se versiona.
BACKUP_DIR=./backups

# Contraseñas de los usuarios de cada microservicio (npm run roles).
# Mínimo 16 caracteres. Genera cada una con: openssl rand -base64 24
IDENTITY_DB_PASSWORD=
CATALOG_DB_PASSWORD=
AUCTION_DB_PASSWORD=
WALLET_DB_PASSWORD=
AUDIT_DB_PASSWORD=
GALLERY_DB_PASSWORD=
