model categories {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String           @unique
  description    String
  image_key      String?
  active         Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  lot_categories lot_categories[]

  @@schema("catalog")
}

model catalog_inbox {
  event_id     String   @id
  event_type   String
  processed_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("inbox")
  @@schema("catalog")
}

model lot_categories {
  lot_id      String     @db.Uuid
  category_id String     @db.Uuid
  is_primary  Boolean    @default(false)
  categories  categories @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  lots        lots       @relation(fields: [lot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([lot_id, category_id])
  @@index([category_id])
  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model lot_images {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_id          String   @db.Uuid
  object_key      String
  position        Int
  perceptual_hash String?
  width_px        Int?
  height_px       Int?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  lots            lots     @relation(fields: [lot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lot_id, position])
  @@index([lot_id])
  @@schema("catalog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model lots {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id           String           @db.Uuid
  title               String
  description         String
  artist_name         String?
  creation_year       Int?
  materials           String
  width_cm            Decimal?         @db.Decimal(8, 2)
  height_cm           Decimal?         @db.Decimal(8, 2)
  depth_cm            Decimal?         @db.Decimal(8, 2)
  provenance          String?
  status              String           @default("BORRADOR")
  visibility          String           @default("PRIVATE")
  authenticity_score  Int?             @db.SmallInt
  suggested_price_min Decimal?         @db.Decimal(12, 2)
  suggested_price_max Decimal?         @db.Decimal(12, 2)
  currency            String           @default("USD") @db.Char(3)
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)
  representation_kind String?
  lot_categories      lot_categories[]
  lot_images          lot_images[]

  @@index([seller_id])
  @@index([status])
  @@schema("catalog")
}

