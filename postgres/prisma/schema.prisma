generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  passwordHash      String   @map("password_hash")
  displayName       String   @map("display_name")
  role              String   @default("USER")
  profileVisibility String   @default("PUBLIC") @map("profile_visibility")
  bio               String?
  avatarUrl         String?  @map("avatar_url")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lots Lot[]

  @@map("users")
}
model Lot {
  id                String   @id @default(uuid()) @db.Uuid
  sellerId          String   @map("seller_id") @db.Uuid
  title             String
  description       String
  artistName        String?  @map("artist_name")
  creationYear      Int?     @map("creation_year")
  materials         String
  widthCm           Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm          Decimal? @map("height_cm") @db.Decimal(8, 2)
  depthCm           Decimal? @map("depth_cm") @db.Decimal(8, 2)
  provenance        String?
  status            String   @default("BORRADOR")
  visibility        String   @default("PRIVATE")
  authenticityScore Int?     @map("authenticity_score") @db.SmallInt
  suggestedPriceMin Decimal? @map("suggested_price_min") @db.Decimal(12, 2)
  suggestedPriceMax Decimal? @map("suggested_price_max") @db.Decimal(12, 2)
  currency          String   @default("USD") @db.Char(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller User @relation(fields: [sellerId], references: [id], onDelete: Restrict)


  @@map("lots")
}
