// Modelo completo de Postgres, un esquema por microservicio.
// Se obtiene por introspeccion de la base migrada (prisma db pull) y no se
// edita a mano: la fuente de verdad son las migraciones SQL de postgres/migrations.
// No hay relaciones entre esquemas porque no hay llaves foraneas entre ellos.
// Cada microservicio declara en su repositorio un schema.prisma con solo su
// esquema; este archivo sirve para validar y documentar el conjunto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auction", "audit", "catalog", "gallery", "identity", "notification", "wallet"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auctions {
  id                                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_id                             String        @unique @db.Uuid
  start_price                        Decimal       @db.Decimal(12, 2)
  current_price                      Decimal       @db.Decimal(12, 2)
  min_increment                      Decimal       @db.Decimal(12, 2)
  currency                           String        @default("USD") @db.Char(3)
  starts_at                          DateTime      @db.Timestamptz(6)
  ends_at                            DateTime      @db.Timestamptz(6)
  initial_ends_at                    DateTime      @db.Timestamptz(6)
  status                             String        @default("PROGRAMADA")
  winner_id                          String?       @db.Uuid
  winning_bid_id                     String?       @unique @db.Uuid
  extension_count                    Int           @default(0)
  created_at                         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime      @default(now()) @db.Timestamptz(6)
  duration_minutes                   Int           @default(60)
  sale_description                   String?
  seller_id                          String        @db.Uuid
  lot_title                          String
  bids_auctions_winning_bid_idTobids bids?         @relation("auctions_winning_bid_idTobids", fields: [winning_bid_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bids_bids_auction_idToauctions     bids[]        @relation("bids_auction_idToauctions")
  transactions                       transactions?

  @@schema("auction")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bids {
  id                                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auction_id                             String    @db.Uuid
  bidder_id                              String    @db.Uuid
  amount                                 Decimal   @db.Decimal(12, 2)
  idempotency_key                        String    @unique
  created_at                             DateTime  @default(now()) @db.Timestamptz(6)
  active                                 Boolean   @default(true)
  auctions_auctions_winning_bid_idTobids auctions? @relation("auctions_winning_bid_idTobids")
  auctions_bids_auction_idToauctions     auctions  @relation("bids_auction_idToauctions", fields: [auction_id], references: [id], onUpdate: NoAction)

  @@index([auction_id, created_at(sort: Desc)])
  @@index([bidder_id])
  @@schema("auction")
}

model auction_inbox {
  event_id     String   @id
  event_type   String
  processed_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("inbox")
  @@schema("auction")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auction_outbox {
  id           String    @id @db.Uuid
  seq          BigInt    @unique @default(autoincrement())
  event_type   String
  aggregate_id String
  payload      Json
  occurred_at  DateTime  @default(now()) @db.Timestamptz(6)
  available_at DateTime  @default(now()) @db.Timestamptz(6)
  attempts     Int       @default(0)
  last_error   String?
  published_at DateTime? @db.Timestamptz(6)

  @@map("outbox")
  @@schema("auction")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auction_id String   @unique @db.Uuid
  lot_id     String   @db.Uuid
  buyer_id   String   @db.Uuid
  seller_id  String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @db.Char(3)
  status     String   @default("PENDIENTE")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  auctions   auctions @relation(fields: [auction_id], references: [id], onUpdate: NoAction)

  @@index([buyer_id])
  @@index([seller_id])
  @@schema("auction")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_summaries {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lot_id                     String   @db.Uuid
  score                      Int      @db.SmallInt
  price_min                  Decimal  @db.Decimal(12, 2)
  price_max                  Decimal  @db.Decimal(12, 2)
  verdict                    String
  has_critical_inconsistency Boolean  @default(false)
  model_name                 String
  prompt_version             String
  created_at                 DateTime @default(now()) @db.Timestamptz(6)
  decided_by                 String?
  dossier_hash               String?
  reports                    reports?

  @@index([lot_id, created_at(sort: Desc)])
  @@schema("audit")
}

model audit_inbox {
  event_id     String   @id
  event_type   String
  processed_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("inbox")
