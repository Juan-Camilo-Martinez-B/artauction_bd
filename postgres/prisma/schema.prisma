generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  passwordHash      String   @map("password_hash")
  displayName       String   @map("display_name")
  role              String   @default("USER")
  profileVisibility String   @default("PUBLIC") @map("profile_visibility")
  bio               String?
  avatarUrl         String?  @map("avatar_url")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lots Lot[]
  wonAuctions Auction[] @relation("AuctionWinner")

  @@map("users")
}
model Lot {
  id                String   @id @default(uuid()) @db.Uuid
  sellerId          String   @map("seller_id") @db.Uuid
  title             String
  description       String
  artistName        String?  @map("artist_name")
  creationYear      Int?     @map("creation_year")
  materials         String
  widthCm           Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm          Decimal? @map("height_cm") @db.Decimal(8, 2)
  depthCm           Decimal? @map("depth_cm") @db.Decimal(8, 2)
  provenance        String?
  status            String   @default("BORRADOR")
  visibility        String   @default("PRIVATE")
  authenticityScore Int?     @map("authenticity_score") @db.SmallInt
  suggestedPriceMin Decimal? @map("suggested_price_min") @db.Decimal(12, 2)
  suggestedPriceMax Decimal? @map("suggested_price_max") @db.Decimal(12, 2)
  currency          String   @default("USD") @db.Char(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller User @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  images LotImage[]
  auction Auction?


  @@map("lots")
}
model LotImage {
  id             String   @id @default(uuid()) @db.Uuid
  lotId          String   @map("lot_id") @db.Uuid
  objectKey      String   @map("object_key")
  position       Int
  perceptualHash String?  @map("perceptual_hash")
  widthPx        Int?     @map("width_px")
  heightPx       Int?     @map("height_px")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, position])
  @@map("lot_images")
}
model Auction {
  id             String   @id @default(uuid()) @db.Uuid
  lotId          String   @unique @map("lot_id") @db.Uuid
  startPrice     Decimal  @map("start_price") @db.Decimal(12, 2)
  currentPrice   Decimal  @map("current_price") @db.Decimal(12, 2)
  minIncrement   Decimal  @map("min_increment") @db.Decimal(12, 2)
  currency       String   @default("USD") @db.Char(3)
  startsAt       DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(6)
  initialEndsAt  DateTime @map("initial_ends_at") @db.Timestamptz(6)
  status         String   @default("PROGRAMADA")
  winnerId       String?  @map("winner_id") @db.Uuid
  winningBidId   String?  @map("winning_bid_id") @db.Uuid
  extensionCount Int      @default(0) @map("extension_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lot    Lot   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  winner User? @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: Restrict)

  @@map("auctions")
}
